{
  "name": "pgl-dialogs",
  "displayName": "PGL Dialogs",
  "description": "Display PGL dialogs on the desktop for VS Code Remote SSH notebooks.",
  "version": "0.3.0",
  "publisher": "gardnerlab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "pglDialogs.selectDesktopPython",
        "title": "PGL Dialogs: Select Desktop Python"
      }
    ]
  },
  "main": "./extension.js"
}
